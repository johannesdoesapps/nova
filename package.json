{
  "name": "orbis-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "templates:sync": "node scripts/site-templates.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "engine": "cd engine && .venv/bin/python -m orbis_engine",
    "engine:worker": "cd engine && .venv/bin/python -m orbis_engine.worker",
    "engine:setup": "cd engine && python3 -m venv .venv && .venv/bin/pip install -r requirements-dev.txt",
    "engine:test": "cd engine && .venv/bin/python -m pytest",
    "eval:agents": "vitest run tests/agent-evals.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vercel/analytics": "^1.6.1",
    "@vercel/sandbox": "^3.8.0",
    "@xyflow/react": "^12.12.0",
    "clsx": "^2.1.1",
    "geist": "^1.8.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "22.x"
  }
}
