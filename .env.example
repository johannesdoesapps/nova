# ───────────────────────────────────────────────────────────────
# NOVA AI — environment variables
# Copy to .env.local and fill in what you have. Every integration is
# optional: anything left empty falls back to clearly-labelled demo mode.
# Never commit .env.local.
# ───────────────────────────────────────────────────────────────

# Supabase (Project Settings → API). The publishable key (sb_publishable_…)
# is preferred; the legacy anon key also works. Both are safe in the browser
# because Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Claude models (recommended default; Claude Haiku 5.5 is used first when set)
ANTHROPIC_API_KEY=

# Google Gemini (OpenAI-compatible endpoint). GEMINI_BASE_URL is optional.
GEMINI_API_KEY=
GEMINI_BASE_URL=

# xAI Grok (OpenAI-compatible). XAI_BASE_URL is optional (default https://api.x.ai/v1).
XAI_API_KEY=
XAI_BASE_URL=

# DeepSeek (OpenAI-compatible). DEEPSEEK_BASE_URL is optional (default https://api.deepseek.com/v1).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# OpenAI — powers chat, search answers and battle models with provider "openai".
OPENAI_API_KEY=
# Optional: an OpenAI-compatible base URL (e.g. a proxy). Leave empty for api.openai.com.
OPENAI_BASE_URL=

# Hugging Face — a fine-grained token with "Make calls to Inference Providers".
# Used for (a) higher Hub API rate limits in Model Discovery and
# (b) running models with provider "huggingface" via router.huggingface.co.
HUGGINGFACE_API_KEY=

# Web search for AI Search. Supported: tavily | brave
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# Model registry override (optional). JSON array; see src/lib/ai/registry.ts.
# Use it to set the exact model IDs and *verified* prices you want to offer.
# NOVA_MODELS=

# Cost controls
NOVA_MAX_COMPARE_MODELS=3
NOVA_DAILY_REQUEST_LIMIT=200
NOVA_RATE_LIMIT_PER_MINUTE=20
# Production without Supabase: paid AI is refused for anonymous visitors unless
# this is "1" (anyone could then spend your API credit). Prefer setting up Supabase.
# NOVA_ALLOW_GUEST_AI=

# Optional error monitoring (wire-up point in src/lib/observability.ts)
SENTRY_DSN=

# Blind trials: secret used to encrypt the A/B → model mapping until you vote.
# Without it, a per-process key is used and pending trials expire on restart.
NOVA_TRIAL_SECRET=

# Provider data-handling facts YOU have verified for your account/contract.
# Unset fields display as "Not verified". Example (illustrative values only):
# NOVA_PRIVACY_PROFILES='{"openai":{"trainsOnApiData":false,"retentionDays":30,"sourceUrl":"https://openai.com/policies/","verifiedAt":"2026-10-18","notes":"Checked against our org settings"}}'

# ─── NOVA engine (Python) — AI Lab, Signal Radar, Workspaces, Integrations ───
# The web app signs short-lived user identities with this secret; set the SAME
# value in the engine's environment. Generate with: openssl rand -base64 32
NOVA_ENGINE_URL=http://127.0.0.1:8787
NOVA_ENGINE_SECRET=

# Engine-only settings (set these in the engine's environment):
# NOVA_ENGINE_DATABASE_URL=sqlite:///./nova_engine.db        # production: Supabase Postgres via the pooler
# NOVA_TOKEN_KEYS=k1:<base64 32-byte key>                      # OAuth token encryption; prepend new keys to rotate
# NOVA_MODEL_PRICES={"openai:gpt-5.6-luna":[0.2,1.2]}           # verified USD per 1M tokens (example values only)
# GITHUB_CLIENT_ID= / GITHUB_CLIENT_SECRET=                    # GitHub OAuth app (callback: <site>/api/engine/connectors/oauth/callback)
# NOVA_RADAR_RETENTION_DAYS=90
# NOVA_ALLOW_PRIVATE_FETCH=1                                   # DEVELOPMENT ONLY: allow feeds on localhost/private IPs
